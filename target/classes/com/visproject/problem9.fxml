<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<Pane
        prefHeight="700.0"
        prefWidth="760.0"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.visproject.controllers.Problem9Controller">

    <children>

        <ImageView
                fx:id="backgroundImage"
                fitWidth="760.0"
                fitHeight="700.0"
                preserveRatio="false"/>

        <Rectangle
                width="760.0"
                height="700.0"
                fill="#06152155"/>

        <Label
                layoutX="30.0"
                layoutY="22.0"
                prefWidth="700.0"
                prefHeight="46.0"
                text="RGB7703 — Хоёр товчлуур"
                style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Label
                layoutX="30.0"
                layoutY="73.0"
                prefWidth="700.0"
                prefHeight="50.0"
                wrapText="true"
                text="Улаан товчлуур тоог 2 дахин ихэсгэнэ · Цэнхэр товчлуур 1-ээр хорогдуулна. n-ээс m-д хамгийн цөөн хэдэн үйлдлээр хүрэх вэ?"
                style="-fx-font-size: 15px; -fx-text-fill: white;"/>

        <TextField
                fx:id="nField"
                layoutX="210.0"
                layoutY="145.0"
                prefWidth="150.0"
                prefHeight="42.0"
                promptText="Эхлэх тоо (n)"
                style="-fx-background-radius: 12; -fx-font-size: 15px;"/>

        <TextField
                fx:id="mField"
                layoutX="400.0"
                layoutY="145.0"
                prefWidth="150.0"
                prefHeight="42.0"
                promptText="Зорилтот тоо (m)"
                style="-fx-background-radius: 12; -fx-font-size: 15px;"/>

        <ImageView
                fx:id="penguinImage"
                layoutX="169.0"
                layoutY="220.0"
                fitWidth="422.0"
                fitHeight="402.0"
                preserveRatio="true"/>

        <Button
                layoutX="190.0"
                layoutY="408.0"
                prefWidth="145.0"
                prefHeight="58.0"
                text="🔴  ×2"
                onAction="#doubleNumber"
                style="-fx-background-color: linear-gradient(to bottom, #ff6b6b, #d92332); -fx-text-fill: white; -fx-font-size: 19px; -fx-font-weight: bold; -fx-background-radius: 30; -fx-border-color: white; -fx-border-width: 3; -fx-border-radius: 30; -fx-effect: dropshadow(gaussian, #00000088, 12, 0.25, 0, 5); -fx-cursor: hand;"/>

        <Button
                layoutX="425.0"
                layoutY="408.0"
                prefWidth="145.0"
                prefHeight="58.0"
                text="🔵  −1"
                onAction="#decreaseNumber"
                style="-fx-background-color: linear-gradient(to bottom, #64c7ff, #1764d8); -fx-text-fill: white; -fx-font-size: 19px; -fx-font-weight: bold; -fx-background-radius: 30; -fx-border-color: white; -fx-border-width: 3; -fx-border-radius: 30; -fx-effect: dropshadow(gaussian, #00000088, 12, 0.25, 0, 5); -fx-cursor: hand;"/>

        <Label
                fx:id="resultLabel"
                layoutX="140.0"
                layoutY="535.0"
                prefWidth="480.0"
                prefHeight="45.0"
                alignment="CENTER"
                wrapText="true"
                style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-color: #06152199; -fx-background-radius: 14;"/>

        <Button
                layoutX="30.0"
                layoutY="640.0"
                prefWidth="190.0"
                prefHeight="42.0"
                text="← Өмнөх бодлого"
                onAction="#previousProblem"
                style="-fx-background-color: #ffffffdd; -fx-text-fill: #153047; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 22; -fx-cursor: hand;"/>

        <Button
                layoutX="540.0"
                layoutY="640.0"
                prefWidth="190.0"
                prefHeight="42.0"
                text="Дараах бодлого →"
                onAction="#nextProblem"
                style="-fx-background-color: #ffffffdd; -fx-text-fill: #153047; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 22; -fx-cursor: hand;"/>

    </children>

</Pane>