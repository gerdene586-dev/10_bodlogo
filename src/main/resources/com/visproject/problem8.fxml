<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane
        prefHeight="400.0"
        prefWidth="600.0"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.visproject.controllers.Problem8Controller">

    <content>

        <AnchorPane prefHeight="400.0" prefWidth="600.0"
                    style="-fx-background-color: #102b3c;">

            <children>

                <ImageView
                        fx:id="backgroundImage"
                        fitWidth="600.0"
                        fitHeight="400.0"
                        preserveRatio="false"/>

                <Rectangle
                        width="600.0"
                        height="400.0"
                        fill="#06152188"/>

                <Label
                        layoutX="20.0"
                        layoutY="20.0"
                        prefWidth="550.0"
                        text="RGB7390 — Палиндром үүсгэ"
                        style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Label
                        layoutX="20.0"
                        layoutY="70.0"
                        prefWidth="550.0"
                        wrapText="true"
                        text="Өгөгдсөн тооны цифрүүдийн байрыг солих замаар хичнээн палиндром тоо үүсгэж болох вэ? Мөн хамгийн их палиндромыг ол."
                        style="-fx-font-size: 14px; -fx-text-fill: white;"/>

                <TextField
                        fx:id="numberField"
                        layoutX="20.0"
                        layoutY="170.0"
                        prefWidth="400.0"
                        promptText="Тоогоо оруулна уу"/>

                <Button
                        layoutX="430.0"
                        layoutY="170.0"
                        prefWidth="120.0"
                        text="Шалгах"
                        onAction="#checkPalindrome"/>

                <Label
                        fx:id="resultLabel"
                        layoutX="20.0"
                        layoutY="240.0"
                        prefWidth="540.0"
                        wrapText="true"
                        style="-fx-font-size: 15px; -fx-text-fill: white; -fx-background-color: #06152199; -fx-background-radius: 10;"/>

                <Button
                        layoutX="400.0"
                        layoutY="330.0"
                        prefWidth="150.0"
                        text="Дараах бодлого →"
                        onAction="#nextProblem"/>

            </children>

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

        </AnchorPane>

    </content>

</ScrollPane>